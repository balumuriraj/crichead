{
  "name": "@crichead/ui",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "default": "./dist/mobile/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo-haptics": ">=13.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "expo-haptics": "~15.0.8",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@crichead/core": "*"
  }
}
