{
  "name": "@crichead/core",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./firebase": {
      "types": "./dist/firebase/index.d.ts",
      "default": "./dist/firebase/index.js"
    },
    "./firebase/admin": {
      "types": "./dist/firebase/admin.d.ts",
      "default": "./dist/firebase/admin.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.18",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1"
  }
}
