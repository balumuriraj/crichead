# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project credentials

# Firebase Client Configuration (Public - safe to expose in client-side code)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin Configuration (Private - NEVER expose in client-side code)
FIREBASE_PROJECT_ID=your-project-id
# Path to your service account key file (download from Firebase Console)
# Place the file in the root directory and add it to .gitignore
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
